# LifeOS Environment Configuration Template
# Copy this file to .env and customize values for your local environment

# Server Configuration
SERVER_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080

# Database Configuration (PostgreSQL 16 + pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# Security & JWT Configuration
# Generate a secure 256-bit secret key for production: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days

# File Storage Configuration
FILE_STORAGE_LOCATION=./uploads
FILE_MAX_SIZE_MB=25

# AI & RAG Configuration
AI_PROVIDER=openai # Options: openai, ollama, mock
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG Parameters
RAG_SIMILARITY_THRESHOLD=0.68
RAG_TOP_K_DENSE=20
RAG_TOP_K_LEXICAL=20
RAG_TOP_K_FINAL=5
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=100

# Scheduler Configuration
SCHEDULER_ENABLED=true
REMINDER_SCAN_CRON="0 0 8 * * ?" # Run daily at 8:00 AM
